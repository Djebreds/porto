# Refi Ahmad Fauzan — personal site (SvelteKit)
# cp .env.example .env

## Site (optional)
# PUBLIC_SITE_URL=https://refifauzan.my.id

## GitHub API (GraphQL)
# GITHUB_API=https://api.github.com/graphql
# GITHUB_API_KEY=ghp_your_personal_access_token
# GITHUB_USERNAME=djebreds

## WakaTime API
# WAKATIME_API=https://wakatime.com/api/v1
# WAKATIME_API_KEY=your_wakatime_api_key

## LeetCode API
# LEETCODE_API=https://leetcode.com/graphql
# LEETCODE_USERNAME=your_leetcode_username

## Giscus comments (GitHub Discussions)
# PUBLIC_GISCUS_REPO=djebreds/personal
# PUBLIC_GISCUS_REPO_ID=
# PUBLIC_GISCUS_CATEGORY=Announcements
# PUBLIC_GISCUS_CATEGORY_ID=

## AI / Ollama
# OLLAMA_URL=https://ai.djebreds.com
# OLLAMA_API_KEY=your_vps_api_key_here
# OLLAMA_MODEL=gemma3:4b

## OpenRouter (primary AI provider — overrides Ollama when set)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=google/gemma-3-4b-it:free
